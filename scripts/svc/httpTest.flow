interface svc
service httpTest (
)
properties {
    favorite: false;
    deprecated: false;
    visible: private;
    reuse: private;
    stateless: true;
    cacheResults: false;
    cacheExpire: 15;
    prefetch: false;
    prefetchActivation: 1;
    allowedHttpMethods: [TRACE, HEAD, DELETE, POST, GET, OPTIONS, PUT, PATCH];
    maxRetryAttempts: 0;
    retryInterval: 0;
    enableAuditing: never;
    logOn: Error only;
    includePipeline: never;
    circuitBreakerEnabled: false;
    failureEvent: Exception only;
    timeoutPeriod: 60;
    cancelThreadOnTimeout: false;
    failureThreshold: 5;
    failurePeriod: 60;
    circuitOpenAction: Throw exception;
    circuitResetPeriod: 300;
    concurrencyEnabled: false;
    maxConcurrentRequests: 20;
    validateInput: false;
    validateOutput: false;
}
{
    INVOKE pub.client:http {
        validateInput: false
        validateOutput: false
        input {
            mapTarget {
                String method;
                String loadAs;
                String url;
            }
            set `method` = "get";
            set `loadAs` = "bytes";
            set `url` = "https://jsonplaceholder.typicode.com/posts";
        }
    }
    INVOKE pub.string:bytesToString {
        validateInput: false
        validateOutput: false
        input {
            mapSource {
                record body {
                    allowUnspecifiedFields: true;
                } {
                    Object bytes {
                        required: false;
                    };
                };
            }
            mapTarget {
                Object bytes;
            }
            copy `/body/bytes` --> `/bytes`;
        }
    }
}
